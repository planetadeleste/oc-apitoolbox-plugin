<?php

namespace {{namespace}};

use Illuminate\Support\Facades\DB;
use {{dtoNamespace}}\{{modelName}}Data;
use {{domainNamespace}}\Services\{{modelName}}Service;
use {{modelNamespace}}\{{modelName}};

/**
 * Action para actualizar {{modelName}}
 */
class Update{{modelName}}Action
{
    public function __construct(
        protected {{modelName}}Service $service
    ) {
    }

    public function execute({{modelName}} $obModel, {{modelName}}Data $data): {{modelName}}
    {
        return DB::transaction(function () use ($obModel, $data) {
            return $this->service->update($obModel, $data->toArray());
        });
    }
}
