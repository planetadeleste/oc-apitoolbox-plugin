<?php

namespace {{namespace}};

use Illuminate\Support\Facades\DB;
use {{dtoNamespace}}\{{modelName}}Data;
use {{domainNamespace}}\Services\{{modelName}}Service;
use {{modelNamespace}}\{{modelName}};

/**
 * Action para crear {{modelName}}
 */
class Create{{modelName}}Action
{
    public function __construct(
        protected {{modelName}}Service $service
    ) {
    }

    public function execute({{modelName}}Data $data): {{modelName}}
    {
        return DB::transaction(function () use ($data) {
            return $this->service->create($data->toArray());
        });
    }
}
